# --- Serveur ---
PORT=8010
ENV=development

# --- MongoDB (même base Atlas que prm_spadcm_backend, EN LECTURE SEULE) ---
# Utiliser un utilisateur Mongo Atlas dédié avec le rôle "read" uniquement
# sur la base prm_spadcm (Atlas > Database Access > Add New Database User).
# Ce service ne doit JAMAIS avoir de droit d'écriture direct sur les
# collections métier (voir README.md, section "Principes de sécurité").
#MONGO_URI=
MONGO_URI=mongodb://localhost:27017/prm_spad_test
MONGO_DB_NAME=prm_spad_test

# --- Sécurité : appel interne depuis prm_spadcm_backend uniquement ---
# Jamais exposé aux apps Flutter. Doit être identique à IA_SERVICE_TOKEN
# côté backend Node (voir INTEGRATION.md et .env.example du backend).
IA_SERVICE_TOKEN=change_moi_avec_une_valeur_longue_et_aleatoire

# URL publique de CE service, utilisée par le backend Node pour l'appeler
# (uniquement informatif ici, sert de rappel de config croisée)
IA_SERVICE_URL=http://localhost:8010

# --- LLM utilisé pour le chat (RAG) et les résumés en langage naturel ---
# Un seul fournisseur actif à la fois, choisi ici. Changer de fournisseur
# = changer cette ligne + la clé correspondante, sans modifier le code
# (voir app/services/llm.py et README.md, "Changer de fournisseur LLM").
#   gemini    -> gratuit, sans carte bancaire (recommandé pour démarrer)
#   groq      -> gratuit, très rapide (Llama/Mixtral)
#   ollama    -> 100% local, gratuit et illimité (dev uniquement)
#   anthropic -> payant
LLM_PROVIDER=gemini

# Google Gemini (clé obtenue gratuitement sur https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq (clé gratuite sur https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (aucune clé : juste l'URL du serveur local, après `ollama serve`)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Anthropic (payant — conservé en option, mêmes conventions que le
# backend Node controllers/assistantController.js)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Callback vers le backend Node (écriture des résultats IA) ---
# Ce service NE PEUT PAS écrire directement dans MongoDB (lecture seule,
# voir plus haut). Il transmet ses résultats via un rappel HTTP sécurisé
# vers le backend Node, qui reste seul responsable de l'écriture
# (voir README.md, endpoint PATCH /api/rapports/:id/resume-ia côté Node).
BACKEND_URL=http://localhost:4000
BACKEND_CALLBACK_TOKEN=change_moi_aussi

# --- Recherche sémantique / RAG ---
# Nombre max de documents (rapports/messages) réinjectés dans le contexte
# envoyé au LLM pour une question du chatbot.
RAG_TOP_K=6
